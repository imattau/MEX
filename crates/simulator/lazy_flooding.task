# Project Chronos: lazy_flooding estimator configuration
# Distribution: us-east-1:3, eu-west-1:2, ap-southeast-1:5

[topology]
distribution = "us-east-1:3,eu-west-1:2,ap-southeast-1:5"

[parameters]
max_allowed_hop_latency_ms = 220.0
bandwidth_limit_kbps = 10000
loss_rate = 0.0
jitter_ms = 0.0

[protocol]
name = "lazy_flooding"
lazy_hops = 3
heartbeat_interval_ms = 100
